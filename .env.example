# Archivo de referencia: guarda los valores reales únicamente en .env.
# Carbonio → Telegram usa estos valores no sensibles por defecto.
ENVIRONMENT=development
LOG_LEVEL=info
TIMEZONE=America/Guayaquil
ACTIVE_SOURCES=["carbonio"]
ALLOWED_SENDERS=[]
SUBJECT_KEYWORDS=[]
CARBONIO_IMAP_PORT=993
CARBONIO_FOLDER=INBOX
CARBONIO_POLL_SECONDS=30
BACKFILL_DAYS=0
MARK_AS_SEEN=false
