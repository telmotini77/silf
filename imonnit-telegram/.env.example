# Configuración IMAP Carbonio
CARBONIO_HOST=mail.tuempresa.com
CARBONIO_PORT=993
CARBONIO_USER=alertas-imonnit@tuempresa.com
CARBONIO_PASSWORD=secreto
CARBONIO_FOLDER=INBOX
# CARBONIO_CA_FILE=/app/ca.crt

# Comportamiento IMAP
IDLE_RENEW_MINUTES=25
BACKFILL_DAYS=0
MARK_AS_SEEN=false
# MOVE_TO=Archive
CACHE_RAW=false

# Filtros (Vacio = acepta todo)
ALLOWED_SENDERS=["alertas@imonnit.com", "noreply@imonnit.com"]
SUBJECT_KEYWORDS=["alerta", "crítica"]

# Telegram
TELEGRAM_BOT_TOKEN=tu_token_aqui
TELEGRAM_CHAT_ID=-100123456789
# Modos: equivalent (HTML formateado), exact (Summary + PDF + EML), both (Todo)
TELEGRAM_MODE=both

# Sistema
TIMEZONE=America/Guayaquil
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/imonnit
ADMIN_TOKEN=generado_con_gen_secrets
MAX_ATTEMPTS=8
LOG_LEVEL=INFO
